# ==========================================
# Production & Domain Configuration (SEO & Social Sharing)
# ==========================================
# The full public URL of your website (used for canonical URLs, sitemap.xml, OpenGraph images)
NEXT_PUBLIC_SITE_URL=https://dots-game.com

# Public WebSocket URL (optional: leave commented out to automatically use Next.js /ws proxy)
# NEXT_PUBLIC_WS_URL=wss://dots-game.com/ws

# ==========================================
# Internal Network & Backend Configuration
# ==========================================
# Internal backend URL for Next.js standalone server rewrites (Docker container name or IP)
BACKEND_URL=http://backend:8080

# Backend server port
SERVER_PORT=8080

# ==========================================
# Game Board Configuration
# ==========================================
# Grid size (Default: 39x39)
BOARD_WIDTH=39
BOARD_HEIGHT=39



